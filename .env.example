# Bridge
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9092
CONTROL_HOST=127.0.0.1
CONTROL_PORT=9093
LOG_LEVEL=INFO

# Providers: fake (no key needed) | voicelab
EDUVOICE_PROVIDER=fake
VOICELAB_API_KEY=
VOICELAB_VOICE_UZ=

# Dialogue tuning (see TASKS.md, step A13)
SILENCE_END_FRAMES=35
BARGE_IN_FRAMES=15
FILLER_AFTER_S=1.2


# CRM (operator workplace)
CRM_HOST=127.0.0.1
CRM_PORT=9095
CRM_SLA_HOURS=24
EDUVOICE_DB=/opt/eduvoice/data/eduvoice.db
RECORDINGS_DIR=/var/spool/asterisk/monitor
# Needed for the "call" button in a citizen card (Asterisk REST interface)
ARI_USER=eduvoice
ARI_PASSWORD=

# Turn taking (measured on the bridge's own audio dumps, 19.09 — see docs/OPERATIONS.md)
PREROLL_MS=900
# Recognition is queued on the provider's side: normally 1.2–1.6 s, but a job was seen
# queued for 55 s. After this many seconds the caller is handed to a person.
STT_TIMEOUT_S=20

# Answering from the regulations (lex.uz, indexed locally by `make lex-fetch`)
LEX_ANSWERS=1
LEX_CLAUSES=3
